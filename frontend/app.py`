import streamlit as st
import requests
import os
from dotenv import load_dotenv
import pdfplumber
import time

load_dotenv()

# --- PREMIUM CONFIGURATION ---
st.set_page_config(
    page_title="CareerBridge AI",
    page_icon="🚀",
    layout="wide",
    initial_sidebar_state="collapsed"
